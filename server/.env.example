PORT=5000

# Local MongoDB. For Atlas use your own mongodb+srv://... string (keep it ONLY in server/.env).
MONGODB_URI=mongodb://127.0.0.1:27017/uiu-alumni

# REQUIRED. The server refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Comma-separated list of allowed frontend origins (enforced for REST and Socket.IO)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Used only by `npm run seed:admin`. Choose your own strong password (10+ characters).
ADMIN_SEED_EMAIL=admin@uiu.ac.bd
ADMIN_SEED_PASSWORD=
